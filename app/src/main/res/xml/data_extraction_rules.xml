<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Installation credentials are bound to a device key that is not backed up -->
        <exclude
            domain="file"
            path="datastore/server_session.preferences_pb" />
        <!-- What the server granted that installation, a restored device is a new one -->
        <exclude
            domain="file"
            path="datastore/server_access.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/server_feeder_link.preferences_pb" />
        <!-- A pending deletion belongs to the installation that started it -->
        <exclude
            domain="file"
            path="datastore/server_deletion.preferences_pb" />
        <!-- The server's feeder monitors of that installation -->
        <exclude
            domain="file"
            path="datastore/settings_feeder_server.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/server_session.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/server_access.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/server_feeder_link.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/server_deletion.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/settings_feeder_server.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
