<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Installation credentials are bound to a device key that is not backed up -->
        <exclude
            domain="file"
            path="datastore/server_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/server_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
